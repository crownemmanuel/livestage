{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LiveStage",
  "version": "../package.json",
  "identifier": "org.salvation.livestudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "node scripts/fetch-ffmpeg.ts && pnpm dev",
    "beforeBuildCommand": "node scripts/fetch-ffmpeg.ts && pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LiveStage",
        "width": 1600,
        "height": 960,
        "minWidth": 1280,
        "minHeight": 760,
        "center": true,
        "resizable": true,
        "backgroundColor": "#15171c",
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --ignore-gpu-blocklist"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Entertainment",
    "shortDescription": "Real-time visual production and show control for theatrical LED walls",
    "externalBin": ["binaries/ffmpeg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVENkY0QUM4QzE0NzY3QzkKUldUSlowZkJ5RXB2N2QzbFdBeWYrcGt1emNaU1c2ZnJWU1ZkQ3lFMURxNHl2a1JyWElyU3BGR1AK",
      "endpoints": ["https://github.com/crownemmanuel/livestage/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
