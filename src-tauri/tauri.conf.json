{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Salvation Live Studio",
  "version": "0.1.0",
  "identifier": "org.salvation.livestudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Salvation Live Studio",
        "width": 1600,
        "height": 960,
        "minWidth": 1280,
        "minHeight": 760,
        "center": true,
        "resizable": true,
        "backgroundColor": "#15171c",
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "Real-time visual production and show control for theatrical LED walls",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
