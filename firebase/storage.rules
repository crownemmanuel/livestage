rules_version = '2';

// Live Studio cloud sync: only the show's own account may read or write.
// Replace SHOW_ACCOUNT_UID with that account's User UID (Firebase console → Authentication → Users),
// then publish these rules (Storage → Rules, or `firebase deploy --only storage` from this folder).
// Anyone with the web API key can create an account, so "signed in" alone is not enough.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == "SHOW_ACCOUNT_UID";
    }
  }
}
